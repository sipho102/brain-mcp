# Copy to .env and fill in. docker-compose.yml reads these.

# Instance name for this vault, e.g. "personal" or "family". Used in server
# identity and log lines — see BRAIN_NAME in the tools' brain_structure()
# output.
BRAIN_NAME=

# Absolute host path to this vault's root, e.g. /mnt/user/brain/<name>.
BRAIN_VAULT_PATH=

# Bearer token required on every MCP request for this instance.
# Generate one with: openssl rand -hex 32
BRAIN_TOKEN=

# Listen port. Only needs setting if you're running more than one instance
# and this one isn't on the default.
# PORT=3100

# Uncomment when the brain-mcp-2 service in docker-compose.yml is enabled,
# for a second sibling vault sharing this same .env file.
# BRAIN_NAME_2=
# BRAIN_VAULT_PATH_2=
# BRAIN_TOKEN_2=

# UID:GID the container runs as. Must be able to write to 00-inbox/ on the
# host share. Defaults to 99:100 (Unraid's nobody:users) if unset.
# BRAIN_UID=99
# BRAIN_GID=100
