# Copy to .env and fill in. docker-compose.yml reads these.

# Bearer token required on every MCP request for the personal_jon instance.
# Generate one with: openssl rand -hex 32
BRAIN_TOKEN=

# Uncomment when the personal_jasmin service in docker-compose.yml is enabled.
# Needs its own var name (not BRAIN_TOKEN) since both services read this
# same .env file.
# BRAIN_TOKEN_JASMIN=

# UID:GID the container runs as. Must be able to write to 00-inbox/ on the
# Unraid share. Defaults to 99:100 (Unraid's nobody:users) if unset.
# BRAIN_UID=99
# BRAIN_GID=100
