# Copy to .env and fill in. docker-compose.yml reads these.
# One container serves one vault. To serve a second vault, copy this whole
# deployment directory (or just its .env) elsewhere with different values
# below, and run `docker compose up -d` from there too.

# Instance name for this vault, e.g. "personal" or "family". Used in server
# identity and log lines, and in the container's name (brain-mcp-<name>).
BRAIN_NAME=

# Absolute host path to this vault's root, e.g. /mnt/user/brain/<name>.
BRAIN_VAULT_PATH=

# Bearer token required on every MCP request for this instance.
# Generate one with: openssl rand -hex 32
BRAIN_TOKEN=

# Listen port. Only needs changing if it collides with another instance's.
# PORT=3100

# UID:GID the container runs as. Must be able to write to 00-inbox/ on the
# host share. Defaults to 99:100 (Unraid's nobody:users) if unset.
# BRAIN_UID=99
# BRAIN_GID=100
